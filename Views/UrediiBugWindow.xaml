<Window x:Class="BugTracker.Views.UrediiBugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uredi napako" Height="570" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="4" CornerRadius="2" Margin="0,0,10,0"
                    Background="{StaticResource WarnBrush}"/>
            <TextBlock x:Name="TxtTitle" Text="Uredi napako" FontSize="18"
                       FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Naslov napake *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtNaslov" Style="{StaticResource InputBox}" MaxLength="200"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Opis napake" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtOpis" Style="{StaticResource InputBox}"
                     Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbStatus" Style="{StaticResource InputCombo}">
                    <ComboBoxItem Content="Odprt"/>
                    <ComboBoxItem Content="V delu"/>
                    <ComboBoxItem Content="Rešen"/>
                    <ComboBoxItem Content="Zaprt"/>
                    <ComboBoxItem Content="Ponovno odprt"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Prioriteta" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbPrio" Style="{StaticResource InputCombo}">
                    <ComboBoxItem Content="Nizka"/>
                    <ComboBoxItem Content="Srednja"/>
                    <ComboBoxItem Content="Visoka"/>
                    <ComboBoxItem Content="Kritična"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kategorija" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbKat" Style="{StaticResource InputCombo}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Dodeljen" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbDodeli" Style="{StaticResource InputCombo}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="10">
            <TextBlock Text="Zgodovina sprememb" Style="{StaticResource FieldLabel}"/>
            <ListBox x:Name="ListHistory" Height="78" FontSize="11"
                     Background="#F8F9FA" BorderBrush="#D0D7DE" BorderThickness="1"
                     IsEnabled="False"/>
        </StackPanel>

        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Prekliči"
                    Style="{StaticResource SecondaryButton}"
                    Padding="0,10" Click="BtnPreklici_Click"/>
            <Button Grid.Column="2" Content="🗑 Izbriši"
                    Style="{StaticResource DangerButton}"
                    Padding="0,10" Click="BtnIzbrisi_Click"/>
            <Button Grid.Column="4" Content="💾 Shrani"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource WarnBrush}"
                    Padding="0,10" Click="BtnShrani_Click"/>
        </Grid>
    </Grid>
</Window>
