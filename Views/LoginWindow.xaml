<Window x:Class="BugTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BugTracker – Prijava" Height="440" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource LightBrush}">
    <Grid>
        <Border Width="5" HorizontalAlignment="Left"
                Background="{StaticResource AccentBrush}"/>
        <StackPanel VerticalAlignment="Center" Margin="50,0">

            <TextBlock Text="🐛 BugTracker" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Prijavite se v sistem" FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,28"/>

            <Border x:Name="ErrBorder" Visibility="Collapsed"
                    Background="#FDECEA" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,14">
                <TextBlock x:Name="ErrText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}"/>
            </Border>

            <TextBlock Text="Uporabniško ime" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtUser" Style="{StaticResource InputBox}"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Geslo" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtPass" Style="{StaticResource InputPassword}"
                         Margin="0,0,0,22"/>

            <Button Content="Prijava" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,10" Click="BtnLogin_Click"/>
            <Button Content="Nimam računa – Registracija"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>
